NUXT_PUBLIC_API_URL=http://localhost:9000
NUXT_PUBLIC_PUBLISHABLE_KEY=pk_dev_placeholder
NUXT_PUBLIC_SENTRY_DSN=
# development | preview | production. Only development and preview expose /_componentes.
NUXT_PUBLIC_APP_ENV=development
# mock | api. "mock" reads the sample catalog; it needs NUXT_INCLUDE_MOCKS=1 at build time (always on
# in development). "api" arrives with FE-04.1b.
NUXT_PUBLIC_DATA_SOURCE=mock
# Footer legal data. Fill in with the values supplied by the legal team; empty values are hidden.
NUXT_PUBLIC_STORE_LEGAL_NAME=
NUXT_PUBLIC_STORE_CNPJ=
NUXT_PUBLIC_STORE_ADDRESS=
NUXT_PUBLIC_STORE_SUPPORT=
NUXT_PUBLIC_STORE_MINORS_NOTICE=
