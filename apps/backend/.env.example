# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tabacaria

# Comma-separated origins. Defaults below are used outside production when empty.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Required in production, at least 32 characters each (e.g. `openssl rand -base64 48`).
JWT_SECRET=
COOKIE_SECRET=
